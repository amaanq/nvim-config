diff --git a/src/nvim/autocmd.c b/src/nvim/autocmd.c
--- a/src/nvim/autocmd.c
+++ b/src/nvim/autocmd.c
@@ -1650,6 +1650,7 @@
   save_funccal(&funccal_entry);
 
   // When starting to execute autocommands, save the search patterns.
+  bool save_did_filetype_nested = false;
   if (!autocmd_busy) {
     save_search_patterns();
     if (!ins_compl_active()) {
@@ -1657,6 +1658,13 @@
       did_save_redobuff = true;
     }
     curbuf->b_did_filetype = curbuf->b_keep_filetype;
+  } else if (event == EVENT_FILETYPE) {
+    // Save b_did_filetype for nested FileType events.  Without this,
+    // a nested "doautoall FileType" (e.g. from vim.lsp.enable() during
+    // lazy plugin loading) permanently sets b_did_filetype on curbuf,
+    // which makes a later "setf" (filetypedetect) a no-op and prevents
+    // filetype detection from working.
+    save_did_filetype_nested = curbuf->b_did_filetype;
   }
 
   // Note that we are applying autocmds.  Some commands need to know.
@@ -1784,6 +1792,11 @@
       xfree(au_pending_free_win);
       au_pending_free_win = w;
     }
+  } else if (event == EVENT_FILETYPE) {
+    // Restore b_did_filetype after nested FileType event so that it
+    // does not leak into the surrounding autocmd chain (e.g. a
+    // BufReadPost handler that still needs filetypedetect to run).
+    curbuf->b_did_filetype = save_did_filetype_nested;
   }
 
   // Some events don't set or reset the Changed flag.
